{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "forest-fire-monitor-55cf4",
          "appId": "1:912980577390:android:8ae2b6fa95cf99209e6a7f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "forest-fire-monitor-55cf4",
          "configurations": {
            "android": "1:912980577390:android:8ae2b6fa95cf99209e6a7f",
            "ios": "1:912980577390:ios:aa98289846aee41f9e6a7f",
            "macos": "1:912980577390:ios:aa98289846aee41f9e6a7f",
            "web": "1:912980577390:web:cd2a4e48c9cb066b9e6a7f",
            "windows": "1:912980577390:web:aeb116c34ade21529e6a7f"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "test", "scripts", "*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|wasm|json)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}
