{
  // Compiles the runtime-independent modules and their tests for node --test.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "src"
  },
  "include": [
    "src/risk.ts",
    "src/thingspeak.ts",
    "src/alertRules.ts",
    "src/firestore.ts",
    "src/*.test.ts"
  ]
}
