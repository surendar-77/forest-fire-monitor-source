{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "include": [
    "src/thingspeak.ts",
    "src/alertRules.ts",
    "src/firestore.ts",
    "src/deviceAlert.ts",
    "src/anomaly.ts",
    "src/terrain.ts",
    "src/fcm.ts",
    "src/fireServices.ts",
    "src/spread.ts",
    "src/firms.ts",
    "src/airQuality.ts",
    "src/fwi.ts",
    "src/fireDanger.ts",
    "src/weather.ts",
    "src/models/*.json",
    "src/*.test.ts"
  ]
}
