app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets: never commit
*adminsdk*.json
*service-account*.json
android/key.properties
*.jks
*.keystore
.env
.env.*

# Backend service and rules tests
backend/.venv/
**/__pycache__/
rules-tests/node_modules/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Build-time keys (copy from config/*.example.json)
config/*.json
!config/*.example.json

# Cloudflare Worker
worker/node_modules/
worker/build/
worker/.wrangler/
worker/.dev.vars

