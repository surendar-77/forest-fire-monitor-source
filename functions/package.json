{
  "name": "forest-fire-functions",
  "private": true,
  "description": "Backend for Forest Fire Monitor: ThingSpeak ingestion, node health, push alerts and roles",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-forest-fire \"node --test test/rules.test.mjs\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "grant-admin": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.0.0",
    "typescript": "^5.9.3"
  }
}
