{
  "rules": {
    ".read": false,
    ".write": false,

    "live": {
      "$node": {
        ".write": "root.child('deviceKeys').child($node).exists() && newData.child('key').val() === root.child('deviceKeys').child($node).val()",
        ".validate": "newData.hasChildren(['values', 'key'])",

        "values": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['ts'])",
          "ts": { ".validate": "newData.val() === now" },
          "t1": { ".validate": "newData.isNumber() && newData.val() > -50 && newData.val() < 100" },
          "h1": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "t2": { ".validate": "newData.isNumber() && newData.val() > -50 && newData.val() < 100" },
          "h2": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "mq1": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095" },
          "mq2": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095" },
          "risk": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "level": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "ai": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "conf": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "up": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "key": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "health": {
      "$node": {
        ".write": "root.child('deviceKeys').child($node).exists() && newData.child('key').val() === root.child('deviceKeys').child($node).val()",
        ".validate": "newData.hasChildren(['info', 'key'])",

        "info": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['ts'])",
          "ts": { ".validate": "newData.val() === now" },
          "up": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "boot": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "boots": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "fw": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "batV": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "bat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "chg": { ".validate": "newData.isBoolean()" },
          "ssid": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "rssi": { ".validate": "newData.isNumber() && newData.val() >= -127 && newData.val() <= 0" },
          "ip": { ".validate": "newData.isString() && newData.val().length <= 15" },
          "net": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "ch": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14" },
          "apc": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "heap": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "minHeap": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "psram": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "chipT": { ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 150" },
          "sent": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "failed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "frames": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "camAge": { ".validate": "newData.isNumber() && newData.val() >= -1" },
          "aiMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "mq": { ".validate": "newData.isString() && newData.val().length <= 48" },
          "dht1": { ".validate": "newData.isBoolean()" },
          "dht2": { ".validate": "newData.isBoolean()" },
          "lora": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "loraTx": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "tsp": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "stuck": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "loraResets": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },

        "key": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "deviceKeys": {
      ".read": false,
      ".write": false
    }
  }
}
